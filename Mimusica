<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mi Música</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    background: linear-gradient(135deg, #0f0f0f, #7b2cff);
    font-family: Arial, sans-serif;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}

.player {
    width: 92%;
    max-width: 400px;
    background: #181818;
    border-radius: 25px;
    padding: 25px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0,0,0,.6);
}

.portada {
    width: 200px;
    height: 200px;
    margin: auto;
    border-radius: 20px;
    background: linear-gradient(135deg, #ff00cc, #3333ff);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 80px;
}

h1 {
    margin-bottom: 5px;
}

p {
    color: #aaa;
}

audio {
    width: 100%;
    margin-top: 20px;
}

.lista {
    margin-top: 25px;
}

.cancion {
    background: #292929;
    padding: 15px;
    margin-top: 10px;
    border-radius: 12px;
    text-align: left;
    cursor: pointer;
}

.cancion:active {
    background: #7b2cff;
}
</style>
</head>

<body>

<div class="player">

    <div class="portada">
        🎵
    </div>

    <h1 id="titulo">Mi Música</h1>
    <p id="artista">Selecciona una canción</p>

    <audio id="audio" controls></audio>

    <div class="lista">

        <h2>🎶 Playlist</h2>

        <div class="cancion"
        onclick="cargarCancion('cancion1.mp3','Canción 1','Artista 1')">
            🎵 Canción 1
        </div>

        <div class="cancion"
        onclick="cargarCancion('cancion2.mp3','Canción 2','Artista 2')">
            🎵 Canción 2
        </div>

        <div class="cancion"
        onclick="cargarCancion('cancion3.mp3','Canción 3','Artista 3')">
            🎵 Canción 3
        </div>

    </div>

</div>

<script>

const audio = document.getElementById("audio");
const titulo = document.getElementById("titulo");
const artista = document.getElementById("artista");

function cargarCancion(archivo, nombre, autor) {

    audio.src = archivo;

    titulo.innerText = nombre;
    artista.innerText = autor;

    audio.play();

}

</script>

</body>
</html>
