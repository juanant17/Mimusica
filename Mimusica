<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mi Reproductor de Música</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #141e30, #6a11cb);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .player {
      width: 90%;
      max-width: 450px;
      background: #181818;
      padding: 30px;
      border-radius: 25px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.5);
      text-align: center;
    }

    .music-icon {
      width: 180px;
      height: 180px;
      margin: 0 auto 20px;
      border-radius: 20px;
      background: linear-gradient(135deg, #9333ea, #ec4899);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
    }

    h1 {
      margin: 10px 0;
      font-size: 28px;
    }

    p {
      color: #aaa;
      margin-bottom: 25px;
    }

    audio {
      width: 100%;
      margin-top: 15px;
    }

    .playlist {
      margin-top: 25px;
      text-align: left;
    }

    .playlist h2 {
      font-size: 20px;
    }

    .song {
      background: #252525;
      padding: 15px;
      margin-top: 10px;
      border-radius: 12px;
      cursor: pointer;
      transition: 0.2s;
    }

    .song:hover {
      background: #9333ea;
    }
  </style>
</head>

<body>

  <div class="player">

    <div class="music-icon">
      🎵
    </div>

    <h1 id="titulo">Mi Música</h1>
    <p id="artista">Selecciona una canción</p>

    <!-- REPRODUCTOR -->
    <audio id="reproductor" controls>
      Tu navegador no soporta el reproductor de audio.
    </audio>

    <div class="playlist">
      <h2>🎶 Canciones</h2>

      <div class="song" onclick="reproducir('music/cancion1.mp3', 'Canción 1', 'Artista 1')">
        🎵 Canción 1
      </div>

      <div class="song" onclick="reproducir('music/cancion2.mp3', 'Canción 2', 'Artista 2')">
        🎵 Canción 2
      </div>

      <div class="song" onclick="reproducir('music/cancion3.mp3', 'Canción 3', 'Artista 3')">
        🎵 Canción 3
      </div>

    </div>

  </div>

  <script>
    const reproductor = document.getElementById("reproductor");
    const titulo = document.getElementById("titulo");
    const artista = document.getElementById("artista");

    function reproducir(archivo, nombre, autor) {
      reproductor.src = archivo;
      titulo.textContent = nombre;
      artista.textContent = autor;

      reproductor.play();
    }
  </script>

</body>
</html>
